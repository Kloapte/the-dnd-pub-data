{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dnd-pub:review:spell-formula-decision-journal:1",
  "description": "Human decision record design only. Schema validity is not reviewer authentication or release authorization.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifactKind",
    "schemaVersion",
    "candidateManifestSha256",
    "headEventSha256",
    "events"
  ],
  "properties": {
    "artifactKind": {
      "const": "REVIEW_DECISION_JOURNAL_NOT_RUNTIME_ALLOWLIST"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "candidateManifestSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "headEventSha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "eventId",
          "sequence",
          "occurrenceId",
          "candidateManifestSha256",
          "bindingSha256",
          "publicationScopeId",
          "attributionProposalSha256",
          "action",
          "reviewerId",
          "reviewerAuthorityRef",
          "rationale",
          "reviewedAt",
          "supersedesEventId",
          "previousEventSha256",
          "eventSha256"
        ],
        "properties": {
          "eventId": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "occurrenceId": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "candidateManifestSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bindingSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "publicationScopeId": {
            "const": "spell-formula-observations-v1-literals"
          },
          "attributionProposalSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "action": {
            "enum": [
              "AUTHORIZE_EXACT_SCOPE",
              "REJECT",
              "WITHDRAW"
            ]
          },
          "reviewerId": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "reviewerAuthorityRef": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "reviewedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "supersedesEventId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          },
          "previousEventSha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "eventSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "action": {
                  "const": "WITHDRAW"
                }
              },
              "required": [
                "action"
              ]
            },
            "then": {
              "properties": {
                "supersedesEventId": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {}
}
