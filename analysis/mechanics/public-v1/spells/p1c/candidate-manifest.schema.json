{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dnd-pub:review:spell-formula-candidates:1",
  "description": "Immutable pending-review evidence, not a publication allowlist. Record human decisions in a separate journal.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifactKind",
    "schemaVersion",
    "manifestId",
    "datasetVersion",
    "publicationAuthorization",
    "bindingHashAlgorithm",
    "publicationScope",
    "inputArtifacts",
    "entries"
  ],
  "properties": {
    "artifactKind": {
      "const": "SPELL_FORMULA_REVIEW_CANDIDATES_NOT_RUNTIME_AUTHORIZATION"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "manifestId": {
      "const": "spell-formulas-v1-p1c-candidates-1"
    },
    "datasetVersion": {
      "const": "5eTools v2.37.0"
    },
    "publicationAuthorization": {
      "const": "NOT_GRANTED"
    },
    "bindingHashAlgorithm": {
      "const": "SHA256_SORTED_KEY_JSON_V1"
    },
    "publicationScope": {
      "const": {
        "id": "spell-formula-observations-v1-literals",
        "publicFieldPaths": [
          "SpellDto.formulaObservations[].occurrenceIndex",
          "SpellDto.formulaObservations[].notation",
          "SpellDto.formulaObservations[].expression.authoredToken",
          "SpellDto.formulaObservations[].expression.lexicalKind",
          "SpellDto.formulaObservations[].attributionId"
        ],
        "allowedNotation": [
          "DAMAGE_TAG",
          "DICE_TAG"
        ],
        "meaning": "Authored syntax observations only; no gameplay effects or inferred relationships",
        "excludedContent": [
          "Raw markup and descriptive entry text",
          "Source evidence pointers, spans, diagnostics and reviewer metadata",
          "Inline scaling arguments, display arguments and opaque expressions",
          "Damage, healing, targeting, save, duration and scaling relationships"
        ]
      }
    },
    "inputArtifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "reviewArtifactPath",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "reviewArtifactPath": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      },
      "minItems": 250,
      "maxItems": 250
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "span": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "integer",
          "minimum": 0
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "artifactSha256",
        "jsonPointer",
        "valueSha256"
      ],
      "properties": {
        "artifactId": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "artifactSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "jsonPointer": {
          "type": "string",
          "pattern": "^(?:/(?:[^~/]|~0|~1)*)*$"
        },
        "valueSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "pendingReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "decision",
        "reviewerId",
        "reviewerAuthorityRef",
        "decisionId",
        "rationale",
        "reviewedAt",
        "releaseScopeId",
        "decisionRecordRef"
      ],
      "properties": {
        "status": {
          "const": "PENDING_REVIEW"
        },
        "decision": {
          "type": "null"
        },
        "reviewerId": {
          "type": "null"
        },
        "reviewerAuthorityRef": {
          "type": "null"
        },
        "decisionId": {
          "type": "null"
        },
        "rationale": {
          "type": "null"
        },
        "reviewedAt": {
          "type": "null"
        },
        "releaseScopeId": {
          "type": "null"
        },
        "decisionRecordRef": {
          "type": "null"
        }
      }
    },
    "sourceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource",
        "resourceSha256",
        "ownerPointer",
        "jsonPointer",
        "entrySection",
        "entryHierarchy",
        "origin",
        "offsetEncoding",
        "spanUtf16",
        "textSha256",
        "tagTokenSha256"
      ],
      "properties": {
        "resource": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "resourceSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "ownerPointer": {
          "type": "string",
          "pattern": "^(?:/(?:[^~/]|~0|~1)*)*$"
        },
        "jsonPointer": {
          "type": "string",
          "pattern": "^(?:/(?:[^~/]|~0|~1)*)*$"
        },
        "entrySection": {
          "enum": [
            "ENTRIES",
            "ENTRIES_HIGHER_LEVEL"
          ]
        },
        "entryHierarchy": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "jsonPointer",
              "authoredType"
            ],
            "properties": {
              "jsonPointer": {
                "type": "string",
                "pattern": "^(?:/(?:[^~/]|~0|~1)*)*$"
              },
              "authoredType": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "origin": {
          "const": "AUTHORED"
        },
        "offsetEncoding": {
          "const": "JAVA_UTF16_HALF_OPEN"
        },
        "spanUtf16": {
          "$ref": "#/$defs/span"
        },
        "textSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "tagTokenSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "expression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authoredToken",
        "sha256",
        "notation",
        "lexicalKind"
      ],
      "properties": {
        "authoredToken": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "notation": {
          "enum": [
            "DAMAGE_TAG",
            "DICE_TAG"
          ]
        },
        "lexicalKind": {
          "enum": [
            "DICE_NOTATION",
            "SIGNED_INTEGER",
            "UNSIGNED_INTEGER"
          ]
        }
      }
    },
    "licensedEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pdfPage",
        "column",
        "normalizedDocumentSpanUtf16",
        "normalizedEntrySpanUtf16",
        "matchedExpression",
        "matchedBeforeWords",
        "matchedAfterWords",
        "contextAnchorSha256",
        "strongLiteralAnchor"
      ],
      "properties": {
        "pdfPage": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "enum": [
            "left",
            "right"
          ]
        },
        "normalizedDocumentSpanUtf16": {
          "$ref": "#/$defs/span"
        },
        "normalizedEntrySpanUtf16": {
          "$ref": "#/$defs/span"
        },
        "matchedExpression": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "matchedBeforeWords": {
          "type": "integer",
          "minimum": 0
        },
        "matchedAfterWords": {
          "type": "integer",
          "minimum": 0
        },
        "contextAnchorSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "strongLiteralAnchor": {
          "const": true
        }
      }
    },
    "licensedMatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentId",
        "documentVersion",
        "documentUrl",
        "documentSha256",
        "spellHeading",
        "descriptor",
        "licenseId",
        "licenseUrl",
        "evidence",
        "matchReference",
        "documentReference"
      ],
      "properties": {
        "documentId": {
          "enum": [
            "SRD-5.1",
            "SRD-5.2.1"
          ]
        },
        "documentVersion": {
          "enum": [
            "5.1",
            "5.2.1"
          ]
        },
        "documentUrl": {
          "type": "string",
          "format": "uri"
        },
        "documentSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "spellHeading": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "descriptor": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "licenseId": {
          "const": "CC-BY-4.0"
        },
        "licenseUrl": {
          "type": "string",
          "format": "uri"
        },
        "evidence": {
          "$ref": "#/$defs/licensedEvidence"
        },
        "matchReference": {
          "$ref": "#/$defs/evidenceReference"
        },
        "documentReference": {
          "$ref": "#/$defs/evidenceReference"
        }
      }
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "noticeId",
        "requiredAttributionSha256",
        "noticeReference",
        "proposalSha256",
        "changesDisclosureSha256"
      ],
      "properties": {
        "noticeId": {
          "enum": [
            "wizards-srd-5.1",
            "wizards-srd-5.2.1"
          ]
        },
        "requiredAttributionSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "noticeReference": {
          "$ref": "#/$defs/evidenceReference"
        },
        "proposalSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "changesDisclosureSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "occurrenceId",
        "spellId",
        "sourceCode",
        "formulaOccurrenceIndex",
        "publicationScopeId",
        "publicationScopeSha256",
        "sourceEvidence",
        "expression",
        "licensedMatch",
        "attribution",
        "eligibility",
        "bindingSha256",
        "review"
      ],
      "properties": {
        "occurrenceId": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "spellId": {
          "type": "string",
          "pattern": "^spell:(phb|xphb):.+$"
        },
        "sourceCode": {
          "enum": [
            "PHB",
            "XPHB"
          ]
        },
        "formulaOccurrenceIndex": {
          "type": "integer",
          "minimum": 0
        },
        "publicationScopeId": {
          "const": "spell-formula-observations-v1-literals"
        },
        "publicationScopeSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sourceEvidence": {
          "$ref": "#/$defs/sourceEvidence"
        },
        "expression": {
          "$ref": "#/$defs/expression"
        },
        "licensedMatch": {
          "$ref": "#/$defs/licensedMatch"
        },
        "attribution": {
          "$ref": "#/$defs/attribution"
        },
        "eligibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "classification",
            "rationale",
            "technicalReliability",
            "p1bReference"
          ],
          "properties": {
            "classification": {
              "const": "VERIFIED_LICENSED_MATCH"
            },
            "rationale": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "technicalReliability": {
              "const": "TAG_SYNTAX_ONLY_NO_EFFECT_ROLE"
            },
            "p1bReference": {
              "$ref": "#/$defs/evidenceReference"
            }
          }
        },
        "bindingSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "review": {
          "$ref": "#/$defs/pendingReview"
        }
      }
    }
  }
}
