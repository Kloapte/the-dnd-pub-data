{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:thedndpub:schemas:core-rules:condition:v1",
  "title": "Condition",
  "allOf": [
    {
      "$ref": "urn:thedndpub:schemas:core-rules:common:v1#/$defs/identity"
    }
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "sourceMetadata",
    "effects"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^condition:[a-z0-9]+(?:-[a-z0-9]+)*:[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "sourceMetadata": {
      "$ref": "urn:thedndpub:schemas:core-rules:common:v1#/$defs/sourceMetadata"
    },
    "levelMechanics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximumLevel",
        "cumulative",
        "application",
        "endsAtLevel"
      ],
      "properties": {
        "maximumLevel": {
          "type": "integer",
          "minimum": 1
        },
        "cumulative": {
          "type": "boolean"
        },
        "application": {
          "enum": [
            "add-specified-levels",
            "add-one-level"
          ]
        },
        "endsAtLevel": {
          "type": "integer",
          "minimum": 0
        },
        "recovery": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "method",
              "levelsRemoved"
            ],
            "properties": {
              "method": {
                "enum": [
                  "long-rest",
                  "raised-from-dead"
                ]
              },
              "levelsRemoved": {
                "type": "integer",
                "minimum": 1
              },
              "requirements": {
                "type": "array",
                "items": {
                  "enum": [
                    "food",
                    "drink"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "effects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "sense",
              "actor"
            ],
            "properties": {
              "kind": {
                "const": "REMOVE_SENSE"
              },
              "sense": {
                "enum": [
                  "sight",
                  "hearing",
                  "smell",
                  "taste",
                  "touch",
                  "special"
                ]
              },
              "actor": {
                "$ref": "urn:thedndpub:schemas:core-rules:common:v1#/$defs/actor"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "roll",
              "requirement",
              "actor"
            ],
            "properties": {
              "kind": {
                "const": "AUTOMATIC_CHECK_FAILURE"
              },
              "roll": {
                "const": "ability-check"
              },
              "requirement": {
                "enum": [
                  "requires-sight",
                  "requires-hearing",
                  "requires-smell",
                  "requires-touch"
                ]
              },
              "actor": {
                "$ref": "urn:thedndpub:schemas:core-rules:common:v1#/$defs/actor"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "roll",
              "direction",
              "actor",
              "target",
              "appliesWhen"
            ],
            "properties": {
              "kind": {
                "const": "ATTACK_ROLL_MODIFIER"
              },
              "roll": {
                "const": "attack"
              },
              "direction": {
                "enum": [
                  "advantage",
                  "disadvantage"
                ]
              },
              "actor": {
                "$ref": "urn:thedndpub:schemas:core-rules:common:v1#/$defs/actor"
              },
              "target": {
                "$ref": "urn:thedndpub:schemas:core-rules:common:v1#/$defs/actor"
              },
              "appliesWhen": {
                "enum": [
                  "attack-targets-affected",
                  "affected-creature-attacks"
                ]
              },
              "minimumLevel": {
                "type": "integer",
                "minimum": 1
              },
              "duration": {
                "enum": [
                  "while-level-threshold-is-met",
                  "while-condition-active"
                ]
              },
              "applicability": {
                "$ref": "#/$defs/applicability"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "roll",
              "direction",
              "actor",
              "duration"
            ],
            "properties": {
              "kind": {
                "const": "CHECK_ROLL_MODIFIER"
              },
              "roll": {
                "enum": [
                  "ability-check",
                  "saving-throw",
                  "attack",
                  "d20-test",
                  "initiative"
                ]
              },
              "direction": {
                "enum": [
                  "advantage",
                  "disadvantage",
                  "bonus",
                  "penalty"
                ]
              },
              "actor": {
                "$ref": "#/$defs/role"
              },
              "ability": {
                "$ref": "urn:thedndpub:schemas:core-rules:common:v1#/$defs/ability"
              },
              "amountPerLevel": {
                "type": "number"
              },
              "duration": {
                "enum": [
                  "while-level-threshold-is-met",
                  "while-condition-active"
                ]
              },
              "applicability": {
                "$ref": "#/$defs/applicability"
              },
              "minimumLevel": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "movement",
              "actor",
              "duration"
            ],
            "properties": {
              "kind": {
                "const": "MOVEMENT_MODIFIER"
              },
              "movement": {
                "enum": [
                  "speed-fraction",
                  "speed-flat"
                ]
              },
              "actor": {
                "$ref": "urn:thedndpub:schemas:core-rules:common:v1#/$defs/actor"
              },
              "amount": {
                "type": "number"
              },
              "amountPerLevel": {
                "type": "number"
              },
              "duration": {
                "enum": [
                  "while-level-threshold-is-met",
                  "while-condition-active"
                ]
              },
              "minimumLevel": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "fraction",
              "minimumLevel",
              "actor",
              "appliesWhen",
              "duration"
            ],
            "properties": {
              "kind": {
                "const": "HIT_POINT_MAX_MODIFIER"
              },
              "fraction": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              },
              "minimumLevel": {
                "type": "integer",
                "minimum": 1
              },
              "actor": {
                "$ref": "urn:thedndpub:schemas:core-rules:common:v1#/$defs/actor"
              },
              "appliesWhen": {
                "const": "at-or-above-level"
              },
              "duration": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "level"
                ],
                "properties": {
                  "kind": {
                    "const": "while-condition-level-at-or-above"
                  },
                  "level": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "atLevel"
            ],
            "properties": {
              "kind": {
                "const": "FATAL_EXHAUSTION_THRESHOLD"
              },
              "atLevel": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "restriction",
              "actor",
              "appliesWhen",
              "duration"
            ],
            "properties": {
              "kind": {
                "const": "RESTRICTION"
              },
              "restriction": {
                "enum": [
                  "cannot-move",
                  "cannot-take-actions",
                  "cannot-take-reactions",
                  "cannot-speak",
                  "cannot-see",
                  "cannot-target",
                  "movement-limited"
                ]
              },
              "actor": {
                "$ref": "urn:thedndpub:schemas:core-rules:common:v1#/$defs/actor"
              },
              "appliesWhen": {
                "enum": [
                  "on-own-turn",
                  "first-turn-of-combat",
                  "until-first-turn-ends",
                  "at-or-above-level",
                  "while-grappled"
                ]
              },
              "minimumLevel": {
                "type": "integer",
                "minimum": 1
              },
              "duration": {
                "const": "while-level-threshold-is-met"
              },
              "amount": {
                "type": "number",
                "minimum": 0
              },
              "unit": {
                "enum": [
                  "feet",
                  "speed-fraction"
                ]
              }
            }
          },
          {
            "$ref": "#/$defs/activityRestriction"
          },
          {
            "$ref": "#/$defs/relationalRestriction"
          },
          {
            "$ref": "#/$defs/automaticSavingThrowFailure"
          },
          {
            "$ref": "#/$defs/conditionInteraction"
          },
          {
            "$ref": "#/$defs/movementConstraint"
          },
          {
            "$ref": "#/$defs/conditionEnding"
          },
          {
            "$ref": "#/$defs/grappledMovementCost"
          },
          {
            "$ref": "#/$defs/criticalHitOnHit"
          },
          {
            "$ref": "#/$defs/physicalState"
          },
          {
            "$ref": "#/$defs/damageMitigation"
          },
          {
            "$ref": "#/$defs/equipmentAndAwareness"
          },
          {
            "$ref": "#/$defs/visibilityCapability"
          },
          {
            "$ref": "#/$defs/categoryImmunity"
          },
          {
            "$ref": "#/$defs/diseaseSuspension"
          }
        ]
      }
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "urn:thedndpub:schemas:core-rules:common:v1#/$defs/reference"
      }
    }
  },
  "$defs": {
    "diseaseSuspension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "lifecycle",
        "preservesInstance",
        "scheduling"
      ],
      "properties": {
        "kind": {
          "const": "SUSPEND_ACTIVE_DISEASES"
        },
        "lifecycle": {
          "const": "while-condition-active"
        },
        "preservesInstance": {
          "const": true
        },
        "scheduling": {
          "const": "UNRESOLVED_BY_SOURCE"
        }
      }
    },
    "role": {
      "enum": [
        "affected-creature",
        "attacker",
        "target",
        "charmer",
        "fear-source",
        "observer",
        "effect-creator",
        "grappler"
      ]
    },
    "conditionReference": {
      "allOf": [
        {
          "$ref": "urn:thedndpub:schemas:core-rules:common:v1#/$defs/reference"
        },
        {
          "type": "object",
          "required": [
            "targetType"
          ],
          "properties": {
            "targetType": {
              "const": "condition"
            }
          }
        }
      ]
    },
    "applicability": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "WHILE_CONDITION_ACTIVE"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "role"
          ],
          "properties": {
            "kind": {
              "const": "FEAR_SOURCE_IN_LINE_OF_SIGHT"
            },
            "role": {
              "const": "fear-source"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "role"
          ],
          "properties": {
            "kind": {
              "const": "CHARMER_SOCIAL_INTERACTION"
            },
            "role": {
              "const": "charmer"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "observer"
          ],
          "properties": {
            "kind": {
              "const": "OBSERVER_CANNOT_SEE_AFFECTED"
            },
            "observer": {
              "$ref": "#/$defs/role"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "creature"
          ],
          "properties": {
            "kind": {
              "const": "TARGET_IS_NOT_CREATURE"
            },
            "creature": {
              "$ref": "#/$defs/role"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "observer"
          ],
          "properties": {
            "kind": {
              "const": "OBSERVER_CAN_SEE_AFFECTED"
            },
            "observer": {
              "$ref": "#/$defs/role"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "otherCreature",
            "distanceFeet",
            "relation"
          ],
          "properties": {
            "kind": {
              "const": "CREATURE_DISTANCE"
            },
            "otherCreature": {
              "$ref": "#/$defs/role"
            },
            "distanceFeet": {
              "type": "number",
              "minimum": 0
            },
            "relation": {
              "enum": [
                "within",
                "beyond"
              ]
            }
          }
        }
      ]
    },
    "activityRestriction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "actor",
        "activities",
        "appliesWhen"
      ],
      "properties": {
        "kind": {
          "const": "ACTIVITY_RESTRICTION"
        },
        "actor": {
          "$ref": "#/$defs/role"
        },
        "activities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "action",
              "bonus-action",
              "reaction",
              "speech",
              "movement"
            ]
          }
        },
        "appliesWhen": {
          "$ref": "#/$defs/applicability"
        },
        "speechLimitation": {
          "enum": [
            "none",
            "faltering"
          ]
        }
      }
    },
    "relationalRestriction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "actor",
        "otherCreature",
        "prohibitedOperation",
        "appliesWhen"
      ],
      "properties": {
        "kind": {
          "const": "RELATIONAL_RESTRICTION"
        },
        "actor": {
          "$ref": "#/$defs/role"
        },
        "otherCreature": {
          "$ref": "#/$defs/role"
        },
        "prohibitedOperation": {
          "enum": [
            "attack",
            "harmful-ability-or-magical-effect",
            "damaging-ability-or-magical-effect",
            "target-creature-with-effect-requiring-sight",
            "willingly-move-closer"
          ]
        },
        "appliesWhen": {
          "$ref": "#/$defs/applicability"
        }
      }
    },
    "automaticSavingThrowFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "actor",
        "abilities",
        "appliesWhen"
      ],
      "properties": {
        "kind": {
          "const": "AUTOMATIC_SAVING_THROW_FAILURE"
        },
        "actor": {
          "$ref": "#/$defs/role"
        },
        "abilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "strength",
              "dexterity"
            ]
          }
        },
        "appliesWhen": {
          "$ref": "#/$defs/applicability"
        }
      }
    },
    "conditionInteraction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "condition",
        "interaction",
        "lifecycle"
      ],
      "properties": {
        "kind": {
          "const": "CONDITION_INTERACTION"
        },
        "condition": {
          "$ref": "#/$defs/conditionReference"
        },
        "interaction": {
          "enum": [
            "apply",
            "immune-to"
          ]
        },
        "lifecycle": {
          "enum": [
            "while-source-condition-active",
            "persists-after-source-condition-ends"
          ]
        }
      }
    },
    "movementConstraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "actor",
        "constraint",
        "appliesWhen"
      ],
      "properties": {
        "kind": {
          "const": "MOVEMENT_CONSTRAINT"
        },
        "actor": {
          "$ref": "#/$defs/role"
        },
        "constraint": {
          "enum": [
            "cannot-increase-speed",
            "crawl-only",
            "cannot-move",
            "cannot-willingly-move-closer-to-source",
            "cannot-stand-when-speed-zero"
          ]
        },
        "appliesWhen": {
          "$ref": "#/$defs/applicability"
        },
        "endingCondition": {
          "$ref": "#/$defs/conditionReference"
        },
        "otherCreature": {
          "$ref": "#/$defs/role"
        },
        "standingCost": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "speedFraction",
            "rounding"
          ],
          "properties": {
            "kind": {
              "const": "SPEND_SPEED_TO_STAND"
            },
            "speedFraction": {
              "const": 0.5
            },
            "rounding": {
              "const": "down"
            }
          }
        }
      }
    },
    "conditionEnding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "condition",
        "when"
      ],
      "properties": {
        "kind": {
          "const": "CONDITION_ENDING"
        },
        "condition": {
          "$ref": "#/$defs/conditionReference"
        },
        "when": {
          "enum": [
            "grappler-incapacitated",
            "target-outside-grappler-reach",
            "creature-stands"
          ]
        }
      }
    },
    "grappledMovementCost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "actor",
        "target",
        "movementMode",
        "movementCost",
        "waiver"
      ],
      "properties": {
        "kind": {
          "const": "GRAPPLED_MOVEMENT_COST"
        },
        "actor": {
          "const": "grappler"
        },
        "target": {
          "const": "affected-creature"
        },
        "movementMode": {
          "const": "drag-or-carry"
        },
        "movementCost": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "multiplier"
              ],
              "properties": {
                "kind": {
                  "const": "SPEED_MULTIPLIER"
                },
                "multiplier": {
                  "const": 0.5
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "additionalFeetPerFoot"
              ],
              "properties": {
                "kind": {
                  "const": "EXTRA_FEET_PER_FOOT"
                },
                "additionalFeetPerFoot": {
                  "const": 1
                }
              }
            }
          ]
        },
        "waiver": {
          "enum": [
            "target-two-or-more-sizes-smaller",
            "target-tiny-or-two-or-more-sizes-smaller"
          ]
        }
      }
    },
    "criticalHitOnHit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "attacker",
        "target",
        "distanceFeet",
        "requiresSuccessfulHit",
        "result"
      ],
      "properties": {
        "kind": {
          "const": "CRITICAL_HIT_ON_HIT"
        },
        "attacker": {
          "const": "attacker"
        },
        "target": {
          "const": "affected-creature"
        },
        "distanceFeet": {
          "const": 5
        },
        "requiresSuccessfulHit": {
          "const": true
        },
        "result": {
          "const": "critical-hit"
        },
        "rule": {
          "$ref": "urn:thedndpub:schemas:core-rules:common:v1#/$defs/reference"
        }
      }
    },
    "physicalState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "state",
        "weightMultiplier",
        "aging"
      ],
      "properties": {
        "kind": {
          "const": "PHYSICAL_STATE"
        },
        "state": {
          "enum": [
            "inanimate-stone",
            "inanimate-source-substance"
          ]
        },
        "includesWornAndCarriedNonmagicalObjects": {
          "type": "boolean"
        },
        "weightMultiplier": {
          "const": 10
        },
        "aging": {
          "const": "ceases"
        }
      }
    },
    "damageMitigation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "damageTypes",
        "mitigation"
      ],
      "properties": {
        "kind": {
          "const": "DAMAGE_MITIGATION"
        },
        "damageTypes": {
          "const": "all"
        },
        "mitigation": {
          "enum": [
            "resistance",
            "immunity"
          ]
        }
      }
    },
    "equipmentAndAwareness": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "actor",
            "effect"
          ],
          "properties": {
            "kind": {
              "const": "DROP_HELD_OBJECTS"
            },
            "actor": {
              "$ref": "#/$defs/role"
            },
            "effect": {
              "const": "drop-held-objects"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "actor",
            "awareness"
          ],
          "properties": {
            "kind": {
              "const": "AWARENESS_RESTRICTION"
            },
            "actor": {
              "$ref": "#/$defs/role"
            },
            "awareness": {
              "const": "unaware"
            }
          }
        }
      ]
    },
    "visibilityCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "actor",
        "capability"
      ],
      "properties": {
        "kind": {
          "const": "VISIBILITY_CAPABILITY"
        },
        "actor": {
          "$ref": "#/$defs/role"
        },
