{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:thedndpub:schemas:core-rules:common:v1",
  "title": "Core Rules Shared Definitions",
  "$defs": {
    "identity": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*:[a-z0-9]+(?:-[a-z0-9]+)*:[a-z0-9]+(?:-[a-z0-9]+)*$",
          "description": "Canonical <type>:<lowercase-source>:<slug> identifier."
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sourceMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "flags": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "srd": {
              "type": "boolean"
            },
            "srd52": {
              "type": "boolean"
            },
            "basicRules": {
              "type": "boolean"
            },
            "basicRules2024": {
              "type": "boolean"
            }
          }
        },
        "citations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "page"
            ],
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "page": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "reprintedAs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/reference"
          }
        }
      },
      "description": "Exact source code, supplied page/flags, and explicit reprint targets."
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetType",
        "id"
      ],
      "properties": {
        "targetType": {
          "enum": [
            "action",
            "background",
            "class",
            "class-feature",
            "condition",
            "creature",
            "disease",
            "feat",
            "item",
            "language",
            "object",
            "optional-feature",
            "rule",
            "sense",
            "skill",
            "source",
            "spell",
            "status",
            "subclass",
            "subclass-feature",
            "vehicle",
            "race"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*:[a-z0-9]+(?:-[a-z0-9]+)*:[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "relationship": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "enum": [
            "END_STATUS",
            "END_CONDITION"
          ]
        }
      },
      "description": "Resolved canonical target. Relationship/operation describes the edge, not target type."
    },
    "ability": {
      "enum": [
        "strength",
        "dexterity",
        "constitution",
        "intelligence",
        "wisdom",
        "charisma"
      ]
    },
    "actor": {
      "enum": [
        "acting-creature",
        "affected-creature",
        "attacker",
        "beneficiary",
        "enemy",
        "grappled-creature",
        "grappler",
        "helper",
        "hidden-creature",
        "larger-creature",
        "moving-creature",
        "opportunity-attacker",
        "observer",
        "source",
        "spell-caster",
        "smaller-creature",
        "target"
      ]
    },
    "actionTrigger": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "actor",
            "target"
          ],
          "properties": {
            "kind": {
              "const": "SPELL_CASTING_OBSERVED"
            },
            "actor": {
              "const": "observer"
            },
            "target": {
              "const": "spell-caster"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "actor"
          ],
          "properties": {
            "kind": {
              "const": "SPELL_DEFINED_REACTION"
            },
            "actor": {
              "const": "spell-caster"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "actor",
            "target"
          ],
          "properties": {
            "kind": {
              "const": "MELEE_ATTACK_MADE"
            },
            "actor": {
              "const": "attacker"
            },
            "target": {
              "const": "creature"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "actor",
            "target"
          ],
          "properties": {
            "kind": {
              "const": "OPPORTUNITY_ATTACK"
            },
            "actor": {
              "const": "attacker"
            },
            "target": {
              "const": "marked-target"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "actor",
            "target"
          ],
          "properties": {
            "kind": {
              "const": "ATTACK_AGAINST_AFFECTED"
            },
            "actor": {
              "const": "attacker"
            },
            "target": {
              "const": "affected-creature"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "actor",
            "target"
          ],
          "properties": {
            "kind": {
              "const": "SAVING_THROW_BY_AFFECTED"
            },
            "actor": {
              "const": "affected-creature"
            },
            "target": {
              "const": "affected-creature"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "actor",
            "target"
          ],
          "properties": {
            "kind": {
              "const": "CREATURE_LEAVES_REACH"
            },
            "actor": {
              "const": "moving-creature"
            },
            "target": {
              "const": "opportunity-attacker"
            },
            "requiresVisibility": {
              "type": "boolean"
            },
            "requiresHostility": {
              "type": "boolean"
            },
            "movementOrigins": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "action",
                  "bonus-action",
                  "reaction",
                  "speed"
                ]
              }
            },
            "excludedMovementSources": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "disengage",
                  "teleportation",
                  "involuntary-movement"
                ]
              }
            },
            "resolutionTiming": {
              "const": "immediately-before-departure"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "actor"
          ],
          "properties": {
            "kind": {
              "const": "PERCEIVABLE_CIRCUMSTANCE"
            },
            "actor": {
              "const": "observer"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "actor",
            "target"
          ],
          "properties": {
            "kind": {
              "const": "GRAPPLER_RELEASES"
            },
            "actor": {
              "const": "grappler"
            },
            "target": {
              "const": "grappled-creature"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "actor",
            "target",
            "volume"
          ],
          "properties": {
            "kind": {
              "const": "HIDDEN_CREATURE_MAKES_SOUND"
            },
            "actor": {
              "const": "hidden-creature"
            },
            "target": {
              "const": "observer"
            },
            "volume": {
              "const": "louder-than-whisper"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "actor",
            "target"
          ],
          "properties": {
            "kind": {
              "const": "ENEMY_FINDS_HIDDEN_CREATURE"
            },
            "actor": {
              "const": "enemy"
            },
            "target": {
              "const": "hidden-creature"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "actor"
          ],
          "properties": {
            "kind": {
              "const": "HIDDEN_CREATURE_MAKES_ATTACK_ROLL"
            },
            "actor": {
              "const": "hidden-creature"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "actor"
          ],
          "properties": {
            "kind": {
              "const": "HIDDEN_CREATURE_CASTS_VERBAL_SPELL"
            },
            "actor": {
              "const": "hidden-creature"
            }
          }
        }
      ]
    },
    "d20RollModifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "roll",
        "direction"
      ],
      "properties": {
        "kind": {
          "const": "D20_ROLL_MODIFIER"
        },
        "roll": {
          "enum": [
            "attack",
            "ability-check",
            "saving-throw",
            "d20-test"
          ]
        },
        "direction": {
          "enum": [
            "advantage",
            "disadvantage",
            "bonus",
            "penalty"
          ]
        },
        "amount": {
          "type": "number"
        },
        "diceCount": {
          "const": 2
        },
        "select": {
          "enum": [
            "higher",
            "lower"
          ]
        },
        "cancelsOpposite": {
          "type": "boolean"
        },
        "multipleInstancesStack": {
          "type": "boolean"
        },
        "ability": {
          "$ref": "#/$defs/ability"
        }
      }
    },
    "attackRoll": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "forms"
      ],
      "properties": {
        "kind": {
          "const": "ATTACK_ROLL"
        },
        "forms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "melee",
              "ranged",
              "spell",
              "weapon",
              "unarmed"
            ]
          }
        },
        "target": {
          "enum": [
            "armor-class",
            "creature",
            "object"
          ]
        },
        "reachFeet": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "bonus": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ability",
            "proficiencyBonus"
          ],
          "properties": {
            "ability": {
              "$ref": "#/$defs/ability"
            },
            "proficiencyBonus": {
              "type": "boolean"
            }
          }
        },
        "criticalOn": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "criticalHitAutomaticallyHits": {
          "type": "boolean"
        }
      }
    },
    "difficultyClass": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "FIXED"
            },
            "value": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "EFFECT_DEFINED"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "base",
            "ability",
            "proficiencyBonus"
          ],
          "properties": {
            "kind": {
              "const": "ABILITY_PLUS_PROFICIENCY"
            },
            "base": {
              "type": "integer",
              "minimum": 0
            },
            "ability": {
              "$ref": "#/$defs/ability"
            },
            "proficiencyBonus": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "base",
            "spellRole"
          ],
          "properties": {
            "kind": {
              "const": "FIXED_PLUS_SPELL_LEVEL"
            },
            "base": {
              "type": "integer",
              "minimum": 0
            },
            "spellRole": {
              "const": "identified-spell"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "minimum",
            "targetRole",
            "ability"
          ],
          "properties": {
            "kind": {
              "const": "GREATER_OF_FIXED_AND_TARGET_ABILITY_SCORE"
            },
            "minimum": {
              "type": "integer",
              "minimum": 1
            },
            "targetRole": {
              "const": "target"
            },
            "ability": {
              "$ref": "#/$defs/ability"
            }
          }
        }
      ]
    },
    "savingThrow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "abilities",
        "abilitySelection",
        "dc"
      ],
      "properties": {
        "kind": {
          "const": "SAVING_THROW"
        },
        "abilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ability"
          }
        },
        "abilitySelection": {
          "enum": [
            "target-chooses",
            "rule-specified",
            "effect"
          ]
        },
        "dc": {
          "$ref": "#/$defs/difficultyClass"
        },
        "mayChooseToFail": {
          "type": "boolean"
        },
        "automaticFailureWhenAbilityScoreAbsent": {
          "type": "boolean"
        }
      }
    },
    "damageRoll": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "damageTypes",
        "base"
      ],
      "properties": {
        "kind": {
          "const": "DAMAGE_ROLL"
        },
        "damageTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "acid",
              "bludgeoning",
              "cold",
              "fire",
              "force",
              "lightning",
              "necrotic",
              "piercing",
              "poison",
              "psychic",
              "radiant",
              "slashing",
              "thunder"
            ]
          }
        },
        "base": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "count",
                "die"
              ],
              "properties": {
                "kind": {
                  "const": "DICE"
                },
                "count": {
                  "type": "integer",
                  "minimum": 1
                },
                "die": {
                  "enum": [
                    "d4",
                    "d6",
                    "d8",
                    "d10",
                    "d12",
                    "d20"
                  ]
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "amount"
              ],
              "properties": {
                "kind": {
                  "const": "FIXED"
                },
                "amount": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          ]
        },
        "abilityModifier": {
          "$ref": "#/$defs/ability"
        }
      }
    },
    "componentApplicability": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "componentId"
          ],
          "properties": {
            "kind": {
              "const": "ON_HIT"
            },
            "componentId": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "componentId"
          ],
          "properties": {
            "kind": {
              "const": "ON_FAILED_SAVE"
            },
            "componentId": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "componentId"
          ],
          "properties": {
            "kind": {
              "const": "ON_CRITICAL_HIT"
            },
            "componentId": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
            }
          }
        }
      ]
    },
    "operationApplicability": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "operationId"
          ],
          "properties": {
            "kind": {
              "const": "CHECK_SUCCEEDED"
            },
            "operationId": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "choiceGroupId"
          ],
          "properties": {
            "kind": {
              "const": "CHOICE_SELECTED"
            },
            "choiceGroupId": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "operationId"
          ],
          "properties": {
            "kind": {
              "const": "SAVE_FAILED"
            },
            "operationId": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "event"
          ],
          "properties": {
            "kind": {
              "const": "TRIGGER_OCCURRED"
            },
            "event": {
              "$ref": "#/$defs/actionTrigger"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "ACTION_TAKEN"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "condition"
          ],
          "properties": {
            "kind": {
              "const": "CONDITION_MET"
            },
            "condition": {
              "$ref": "#/$defs/conditionPredicate"
            }
          }
        }
      ]
    },
    "turnTiming": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "action",
                "bonus-action",
                "free"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "trigger"
          ],
          "properties": {
            "kind": {
              "const": "reaction"
            },
            "trigger": {
              "$ref": "#/$defs/actionTrigger"
            }
          }
        },
        {
          "$ref": "#/$defs/gameTimeTiming"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "varied_gametime"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "options"
          ],
          "properties": {
            "kind": {
              "const": "alternatives"
            },
            "options": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/turnTiming"
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "gameTimeTiming": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "amount",
        "unit"
      ],
      "properties": {
        "kind": {
          "const": "fixed_gametime"
        },
        "amount": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit": {
          "enum": [
            "minute",
            "hour",
            "day"
          ]
        }
      }
    },
    "conditionReference": {
      "allOf": [
        {
          "$ref": "#/$defs/reference"
        },
        {
          "type": "object",
          "required": [
            "targetType"
          ],
          "properties": {
            "targetType": {
              "const": "condition"
            }
          }
        }
      ]
    },
    "conditionPredicate": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "actor",
            "condition"
          ],
          "properties": {
            "kind": {
              "const": "HAS_CONDITION"
            },
            "actor": {
              "enum": [
                "acting-creature",
                "target",
                "affected-creature",
                "grappler",
                "attacker",
                "grappled-creature",
                "marked-target"
              ]
            },
            "condition": {
              "$ref": "#/$defs/conditionReference"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "actor"
          ],
          "properties": {
            "kind": {
              "const": "SPEED_IS_ZERO"
            },
            "actor": {
              "enum": [
                "acting-creature",
                "target",
                "affected-creature",
                "grappler",
                "attacker",
                "grappled-creature",
                "marked-target"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
