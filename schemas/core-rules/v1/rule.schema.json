{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:thedndpub:schemas:core-rules:rule:v1",
  "title": "Rule",
  "description": "A source-qualified core, optional, variant, or other rule entry without inferred type-code meanings.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "source", "name", "page", "entries"],
  "properties": {
    "id": {"type": "string", "pattern": "^rule:[^:]+:.+$"},
    "source": {"$ref": "urn:thedndpub:schemas:core-rules:common:v1#/$defs/nonEmptyString"},
    "name": {"$ref": "urn:thedndpub:schemas:core-rules:common:v1#/$defs/displayText"},
    "page": {"type": "integer", "minimum": 1},
    "sourceFlags": {"$ref": "urn:thedndpub:schemas:core-rules:common:v1#/$defs/sourceFlags"},
    "ruleType": {"enum": ["C", "O", "V", "VO"]},
    "type": {"enum": ["section", "entries"], "description": "The separate source field; do not derive it from ruleType."},
    "entries": {"$ref": "urn:thedndpub:schemas:core-rules:common:v1#/$defs/richTextArray"},
    "reprintedAs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "urn:thedndpub:schemas:core-rules:common:v1#/$defs/reprintReference"}
    },
    "additionalSources": {"type": "array", "minItems": 1, "items": {"$ref": "urn:thedndpub:schemas:core-rules:common:v1#/$defs/sourceCitation"}},
    "references": {"type": "array", "minItems": 1, "items": {"$ref": "urn:thedndpub:schemas:core-rules:common:v1#/$defs/modelReference"}}
  }
}
