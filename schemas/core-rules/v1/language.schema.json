{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:thedndpub:schemas:core-rules:language:v1",
  "title": "Language",
  "description": "A source-qualified language record; script names remain supplied strings without assumed catalog references.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "source", "name", "page"],
  "properties": {
    "id": {"type": "string", "pattern": "^language:[^:]+:.+$"},
    "source": {"$ref": "urn:thedndpub:schemas:core-rules:common:v1#/$defs/nonEmptyString"},
    "name": {"$ref": "urn:thedndpub:schemas:core-rules:common:v1#/$defs/displayText"},
    "page": {"type": "integer", "minimum": 1},
    "sourceFlags": {"$ref": "urn:thedndpub:schemas:core-rules:common:v1#/$defs/sourceFlags"},
    "reprintedAs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "urn:thedndpub:schemas:core-rules:common:v1#/$defs/reprintReference"}
    },
    "typicalSpeakers": {"type": "array", "minItems": 1, "items": {"$ref": "urn:thedndpub:schemas:core-rules:common:v1#/$defs/displayText"}},
    "type": {"enum": ["standard", "exotic", "rare", "secret"]},
    "script": {"$ref": "urn:thedndpub:schemas:core-rules:common:v1#/$defs/displayText"},
    "origin": {"$ref": "urn:thedndpub:schemas:core-rules:common:v1#/$defs/displayText"},
    "entries": {"$ref": "urn:thedndpub:schemas:core-rules:common:v1#/$defs/richTextArray"},
    "hasFluffImages": {"type": "boolean"},
    "fonts": {"type": "array", "minItems": 1, "items": {"$ref": "urn:thedndpub:schemas:core-rules:common:v1#/$defs/displayText"}},
    "additionalSources": {"type": "array", "minItems": 1, "items": {"$ref": "urn:thedndpub:schemas:core-rules:common:v1#/$defs/sourceCitation"}},
    "dialects": {"type": "array", "minItems": 1, "items": {"$ref": "urn:thedndpub:schemas:core-rules:common:v1#/$defs/displayText"}},
    "otherSources": {"type": "array", "minItems": 1, "items": {"$ref": "urn:thedndpub:schemas:core-rules:common:v1#/$defs/sourceCitation"}},
    "references": {"type": "array", "minItems": 1, "items": {"$ref": "urn:thedndpub:schemas:core-rules:common:v1#/$defs/modelReference"}}
  }
}
