{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:thedndpub:schemas:core-rules:language:v1",
  "title": "Language",
  "allOf": [
    {
      "$ref": "urn:thedndpub:schemas:core-rules:common:v1#/$defs/identity"
    }
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "sourceMetadata"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^language:[a-z0-9]+(?:-[a-z0-9]+)*:[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "sourceMetadata": {
      "$ref": "urn:thedndpub:schemas:core-rules:common:v1#/$defs/sourceMetadata"
    },
    "category": {
      "enum": [
        "standard",
        "exotic",
        "rare",
        "secret"
      ]
    },
    "script": {
      "type": "string",
      "minLength": 1
    },
    "origin": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "urn:thedndpub:schemas:core-rules:common:v1#/$defs/reference"
      }
    },
    "typicalSpeakers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "targetType",
              "id"
            ],
            "properties": {
              "targetType": {
                "const": "creature"
              },
              "id": {
                "type": "string",
                "pattern": "^creature:[a-z0-9-]+:[a-z0-9-]+$"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "filter"
            ],
            "properties": {
              "filter": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "targetType",
                  "creatureTypes"
                ],
                "properties": {
                  "targetType": {
                    "const": "creature"
                  },
                  "creatureTypes": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "aberration",
                        "beast",
                        "celestial",
                        "construct",
                        "dragon",
                        "elemental",
                        "fey",
                        "fiend",
                        "giant",
                        "humanoid",
                        "monstrosity",
                        "ooze",
                        "plant",
                        "undead"
                      ]
                    }
                  },
                  "tags": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "group",
                        "value"
                      ],
                      "properties": {
                        "group": {
                          "type": "string",
                          "minLength": 1
                        },
                        "value": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  },
                  "sources": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    "dialects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "urn:thedndpub:schemas:core-rules:common:v1#/$defs/reference"
      }
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "urn:thedndpub:schemas:core-rules:common:v1#/$defs/reference"
      }
    }
  }
}
